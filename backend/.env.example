# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vantta

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Optional: public base URL of this API, used to build absolute URLs for
# uploaded files (ex: supermarket logo). If unset, it's derived from the
# incoming request (protocol + host).
# PUBLIC_URL=https://vantta-api.onrender.com

# Seed script (initial admin user)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@vantta.com
SEED_ADMIN_PASSWORD=change-me-123
